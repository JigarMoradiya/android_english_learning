<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude all SharedPreferences from cloud backup and device transfer.
     Progress data is user-specific and should not survive a fresh install.
     Note: This file applies to devices running Android 12 and above. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
